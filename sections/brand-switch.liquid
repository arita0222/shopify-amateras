{%- liquid
  assign amateras_label = section.settings.amateras_label | default: 'AMATERAS'
  assign wabi_label     = section.settings.wabi_label     | default: 'WABI'
  assign redirect_url   = section.settings.redirect_url   | default: '/'
  assign bar_alignment  = section.settings.bar_alignment  | default: 'center'
  assign logo_height    = section.settings.logo_height    | default: 24
  assign wabi_logo      = section.settings.wabi_logo
  assign amateras_logo  = section.settings.amateras_logo
  assign wabi_logo_width_pc         = section.settings.wabi_logo_width_pc         | default: 80
  assign wabi_logo_width_mobile     = section.settings.wabi_logo_width_mobile     | default: 60
  assign amateras_logo_width_pc     = section.settings.amateras_logo_width_pc     | default: 80
  assign amateras_logo_width_mobile = section.settings.amateras_logo_width_mobile | default: 60
  assign bar_alignment_mobile       = section.settings.bar_alignment_mobile       | default: 'center'
-%}

{%- style -%}
  :root {
    --brand-amateras-header-bg:   {{ section.settings.amateras_header_bg }};
    --brand-amateras-header-text: {{ section.settings.amateras_header_text }};
    --brand-amateras-header-accent: {{ section.settings.amateras_header_accent }};
    --brand-wabi-header-bg:       {{ section.settings.wabi_header_bg }};
    --brand-wabi-header-text:     {{ section.settings.wabi_header_text }};
    --brand-wabi-header-accent:   {{ section.settings.wabi_header_accent }};
    --brand-amateras-footer-bg:   {{ section.settings.amateras_footer_bg }};
    --brand-amateras-footer-text: {{ section.settings.amateras_footer_text }};
    --brand-wabi-footer-bg:       {{ section.settings.wabi_footer_bg }};
    --brand-wabi-footer-text:     {{ section.settings.wabi_footer_text }};
    --brand-switch-logo-height:   {{ logo_height }}px;
    --brand-switch-wabi-logo-width-pc: {{ wabi_logo_width_pc }}px;
    --brand-switch-wabi-logo-width-mobile: {{ wabi_logo_width_mobile }}px;
    --brand-switch-amateras-logo-width-pc: {{ amateras_logo_width_pc }}px;
    --brand-switch-amateras-logo-width-mobile: {{ amateras_logo_width_mobile }}px;
  }
{%- endstyle -%}

<div
  class="brand-switch-bar"
  id="brand-switch-bar"
  data-alignment="{{ bar_alignment }}"
  data-alignment-mobile="{{ bar_alignment_mobile }}">
  <button
    class="brand-switch-bar__btn brand-switch-bar__btn--wabi"
    data-brand-btn="wabi"
    data-brand-redirect="{{ redirect_url }}"
    aria-pressed="true"
    aria-label="{{ wabi_label }}"
    type="button">
    {%- if wabi_logo != blank -%}
      {{ wabi_logo | image_url: width: 400 | image_tag: alt: wabi_label, class: 'brand-switch-bar__logo', loading: 'eager' }}
    {%- else -%}
      <span class="brand-switch-bar__text">{{ wabi_label }}</span>
    {%- endif -%}
  </button>
  <button
    class="brand-switch-bar__btn brand-switch-bar__btn--amateras"
    data-brand-btn="amateras"
    data-brand-redirect="{{ redirect_url }}"
    aria-pressed="false"
    aria-label="{{ amateras_label }}"
    type="button">
    {%- if amateras_logo != blank -%}
      {{ amateras_logo | image_url: width: 400 | image_tag: alt: amateras_label, class: 'brand-switch-bar__logo', loading: 'eager' }}
    {%- else -%}
      <span class="brand-switch-bar__text">{{ amateras_label }}</span>
    {%- endif -%}
  </button>
</div>

<script src="{{ 'brand-switch.js' | asset_url }}" defer></script>
<script>
  // pageheaderへの即時移動（headerが先に読まれた直後に実行）
  (function tryMove() {
    var bar = document.getElementById('brand-switch-bar');
    var ph = document.getElementById('pageheader');
    if (bar && ph && bar.parentElement !== ph) {
      ph.insertBefore(bar, ph.firstChild);
    } else if (!ph) {
      requestAnimationFrame(tryMove);
    }
  })();
</script>

{% schema %}
{
  "name": "Brand Switch",
  "settings": [
    {
      "type": "header",
      "content": "表示設定"
    },
    {
      "type": "select",
      "id": "bar_alignment",
      "label": "バーの位置",
      "options": [
        { "value": "left",   "label": "左" },
        { "value": "center", "label": "中央" },
        { "value": "right",  "label": "右" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "bar_alignment_mobile",
      "label": "バーの位置(モバイル)",
      "options": [
        { "value": "left",   "label": "左" },
        { "value": "center", "label": "中央" },
        { "value": "right",  "label": "右" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "ロゴ画像"
    },
    {
      "type": "image_picker",
      "id": "wabi_logo",
      "label": "WABIロゴ",
      "info": "未設定の場合はWABIラベルのテキストを表示します"
    },
    {
      "type": "image_picker",
      "id": "amateras_logo",
      "label": "MAISONロゴ",
      "info": "未設定の場合はAMATERASラベルのテキストを表示します"
    },
    {
      "type": "range",
      "id": "wabi_logo_width_pc",
      "label": "WABIロゴ幅(PC)",
      "min": 40,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "wabi_logo_width_mobile",
      "label": "WABIロゴ幅(モバイル)",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "amateras_logo_width_pc",
      "label": "MAISONロゴ幅(PC)",
      "min": 40,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "amateras_logo_width_mobile",
      "label": "MAISONロゴ幅(モバイル)",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "ロゴ高さ(上限)",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "ブランド名(ロゴ未設定時のテキスト)"
    },
    {
      "type": "text",
      "id": "amateras_label",
      "label": "AMATERASラベル",
      "default": "MAISON"
    },
    {
      "type": "text",
      "id": "wabi_label",
      "label": "WABIラベル",
      "default": "WABI"
    },
    {
      "type": "url",
      "id": "redirect_url",
      "label": "TOP以外からのリダイレクト先",
      "info": "未設定時はトップページ(/)へ"
    },
    {
      "type": "header",
      "content": "AMATERASヘッダー色"
    },
    {
      "type": "color",
      "id": "amateras_header_bg",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "amateras_header_text",
      "label": "テキスト色",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "amateras_header_accent",
      "label": "アクセント色",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "WABIヘッダー色"
    },
    {
      "type": "color",
      "id": "wabi_header_bg",
      "label": "背景色",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "wabi_header_text",
      "label": "テキスト色",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "wabi_header_accent",
      "label": "アクセント色",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "AMATERASフッター色"
    },
    {
      "type": "color",
      "id": "amateras_footer_bg",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "amateras_footer_text",
      "label": "テキスト色",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "WABIフッター色"
    },
    {
      "type": "color",
      "id": "wabi_footer_bg",
      "label": "背景色",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "wabi_footer_text",
      "label": "テキスト色",
      "default": "#f5f5f5"
    }
  ],
  "presets": [
    {
      "name": "Brand Switch"
    }
  ]
}
{% endschema %}
